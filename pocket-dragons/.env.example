# Copy to .env and fill in. Without SMTP_URL the dev server prints login codes to the console.
PORT=3000
# smtp(s)://user:password@host:port — works with Resend, SendGrid, Mailgun, Gmail, etc.
SMTP_URL=
MAIL_FROM="Keepers' Lair <no-reply@example.com>"
# Comma-separated emails that can moderate chat and content
ADMIN_EMAILS=
# SQLite file location
DATABASE_PATH=./data/pocket-dragons.db
# Extra origins allowed to call the API (comma-separated), e.g. https://lair.example.com
ALLOWED_ORIGINS=
